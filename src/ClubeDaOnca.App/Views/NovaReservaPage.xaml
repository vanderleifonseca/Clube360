<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             xmlns:reservas="clr-namespace:ClubeDaOnca.Contracts.Reservas;assembly=ClubeDaOnca.Contracts"
             x:Class="ClubeDaOnca.App.Views.NovaReservaPage"
             x:DataType="vm:NovaReservaViewModel"
             Title="Nova reserva">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="640">
            <Label Text="Espaço" />
            <Picker ItemsSource="{Binding Espacos}" SelectedItem="{Binding Espaco}"
                    ItemDisplayBinding="{Binding Nome, x:DataType=reservas:EspacoDto}" />

            <Border Style="{StaticResource Cartao}" IsVisible="{Binding Regras, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                <Label Text="{Binding Regras}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            </Border>

            <Label Text="Data" />
            <DatePicker Date="{Binding Data}" Format="dd/MM/yyyy" MinimumDate="{Binding Hoje}" MaximumDate="{Binding DataMaxima}" />

            <Label Text="Horário" />
            <Label Text="{Binding AvisoHorarios}" IsVisible="{Binding AvisoHorarios, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

            <FlexLayout BindableLayout.ItemsSource="{Binding Horarios}" Wrap="Wrap" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HorarioItem">
                        <Border Margin="0,0,8,8" Padding="12,8" WidthRequest="120" StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource Primary}" StrokeThickness="1" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NovaReservaViewModel}}, Path=SelecionarCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Livre}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Stroke" Value="{StaticResource Gray400}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Texto}" FontAttributes="Bold" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Legenda}" FontSize="12" HorizontalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="Observação (opcional)" />
            <Editor Text="{Binding Observacao}" Placeholder="Ex.: aniversário, número de convidados" AutoSize="TextChanges" MaxLength="500" />

            <Label Text="{Binding Erro}" TextColor="{StaticResource Erro}"
                   IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <Button Text="Reservar" Command="{Binding ConfirmarCommand}"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
