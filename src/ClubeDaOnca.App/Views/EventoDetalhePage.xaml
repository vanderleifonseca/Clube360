<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             x:Class="ClubeDaOnca.App.Views.EventoDetalhePage"
             x:DataType="vm:EventoDetalheViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8" MaximumWidthRequest="720">
            <Label Text="{Binding Titulo}" Style="{StaticResource Headline}" HorizontalOptions="Start" />
            <Label Text="{Binding Quando}" FontAttributes="Bold" />
            <Label Text="{Binding Onde}" />
            <Label Text="{Binding Ocupacao}" FontSize="13" />
            <Label Text="{Binding Descricao}" Margin="0,8,0,0"
                   IsVisible="{Binding Descricao, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
            <Label Text="{Binding Avisos}" FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Label Text="Reservar" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" Margin="0,12,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ambientes}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AmbienteLinha">
                        <Border Style="{StaticResource Cartao}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                    <Label Text="{Binding Detalhe}" FontSize="13" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Reservar" VerticalOptions="Center"
                                        IsEnabled="{Binding Esgotado, Converter={StaticResource InvertedBoolConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventoDetalheViewModel}}, Path=ReservarCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding Erro}" TextColor="{StaticResource Erro}"
                   IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
            <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
