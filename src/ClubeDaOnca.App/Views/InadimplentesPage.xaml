<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             x:Class="ClubeDaOnca.App.Views.InadimplentesPage"
             x:DataType="vm:InadimplentesViewModel"
             Title="Inadimplentes">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8" MaximumWidthRequest="900">
        <Label Text="{Binding Resumo}" FontAttributes="Bold" />
        <Label Grid.Row="1" Text="{Binding Erro}" TextColor="{StaticResource Erro}"
               IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
        <RefreshView Grid.Row="2" Command="{Binding CarregarCommand}" IsRefreshing="{Binding Carregando}">
            <CollectionView ItemsSource="{Binding Itens}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InadimplenteLinha">
                        <Border Style="{StaticResource Cartao}" Margin="0,4">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding Detalhe}" FontSize="13" TextColor="{StaticResource Erro}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
