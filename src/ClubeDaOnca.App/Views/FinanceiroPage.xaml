<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             x:Class="ClubeDaOnca.App.Views.FinanceiroPage"
             x:DataType="vm:FinanceiroViewModel"
             Title="Financeiro">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="8" MaximumWidthRequest="720">
        <Border Style="{StaticResource Cartao}">
            <VerticalStackLayout>
                <Label Text="Total em aberto" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding TotalEmAberto}" FontSize="28" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF3C7"
                IsVisible="{Binding Aviso, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Inadimplente}" Value="True">
                    <Setter Property="BackgroundColor" Value="#FDE2E1" />
                </DataTrigger>
            </Border.Triggers>
            <Label Text="{Binding Aviso}" TextColor="#5C2E00" />
        </Border>

        <Label Grid.Row="2" Text="{Binding Erro}" TextColor="{StaticResource Erro}"
               IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

        <RefreshView Grid.Row="3" Command="{Binding CarregarCommand}" IsRefreshing="{Binding Carregando}">
            <CollectionView ItemsSource="{Binding Itens}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma cobrança por aqui." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CobrancaLinha">
                        <Border Style="{StaticResource Cartao}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Descricao}" FontAttributes="Bold" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detalhe}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LinhaDigitavel, StringFormat='Boleto: {0}'}" FontSize="12"
                                       IsVisible="{Binding TemBoleto}" />

                                <Label Grid.Column="1" Text="{Binding Valor}" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Grid.Row="1" Text="{Binding Situacao}" FontSize="13" VerticalOptions="Center" TextColor="{StaticResource Gray500}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Paga">
                                            <Setter Property="TextColor" Value="#1B873F" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Vencida">
                                            <Setter Property="TextColor" Value="{StaticResource Erro}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Button Grid.Row="1" Grid.Column="1" Text="Pagar" IsVisible="{Binding Aberta}" Margin="0,6,0,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceiroViewModel}}, Path=PagarCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
