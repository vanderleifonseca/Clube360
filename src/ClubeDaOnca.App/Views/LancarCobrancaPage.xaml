<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             xmlns:socios="clr-namespace:ClubeDaOnca.Contracts.Socios;assembly=ClubeDaOnca.Contracts"
             x:Class="ClubeDaOnca.App.Views.LancarCobrancaPage"
             x:DataType="vm:LancarCobrancaViewModel"
             Title="Lançar cobrança">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="640">
            <Label Text="Cobrança avulsa (multa, consumo, conserto etc.). O sócio é avisado no app e por e-mail e paga pela aba Financeiro, com Pix ou boleto."
                   FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <!-- 1. Sócio -->
            <Label Text="Sócio" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
            <VerticalStackLayout Spacing="8" IsVisible="{Binding SemSocio}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Placeholder="Nome, CPF ou nº do título" Text="{Binding Busca}" ReturnType="Search"
                           ReturnCommand="{Binding BuscarCommand}" />
                    <Button Grid.Column="1" Text="Buscar" Command="{Binding BuscarCommand}" />
                </Grid>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resultados}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="socios:SocioResumoDto">
                            <Border Style="{StaticResource Cartao}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LancarCobrancaViewModel}}, Path=EscolherCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                    <Label FontSize="13">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Título nº " />
                                                <Span Text="{Binding NumeroTitulo}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding Situacao}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border Style="{StaticResource Cartao}" IsVisible="{Binding TemSocio}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding SocioTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Trocar" Command="{Binding TrocarSocioCommand}" />
                </Grid>
            </Border>

            <!-- 2. Dados da cobrança -->
            <Label Text="Descrição" Margin="0,8,0,0" />
            <Entry Placeholder="ex.: Multa por dano à quadra de tênis" Text="{Binding Descricao}" MaxLength="200" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Label Text="Valor (R$)" />
                <Entry Grid.Row="1" Placeholder="ex.: 85,50" Text="{Binding Valor}" Keyboard="Numeric" />
                <Label Grid.Column="1" Text="Vencimento" />
                <DatePicker Grid.Column="1" Grid.Row="1" Date="{Binding Vencimento}" MinimumDate="{Binding Hoje}" Format="dd/MM/yyyy" />
            </Grid>

            <Label Text="{Binding Erro}" TextColor="{StaticResource Erro}"
                   IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <Button Text="Lançar cobrança" Command="{Binding SalvarCommand}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
