<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             x:Class="ClubeDaOnca.App.Views.EventosPage"
             x:DataType="vm:EventosViewModel"
             Title="Eventos">

    <RefreshView Command="{Binding CarregarCommand}" IsRefreshing="{Binding Carregando}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8" MaximumWidthRequest="900">
                <Button Text="+ Novo evento" Command="{Binding NovoCommand}" IsVisible="{Binding Gestao}" HorizontalOptions="Start" />
                <Label Text="{Binding Erro}" TextColor="{StaticResource Erro}"
                       IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                <!-- Minhas reservas (sócio) -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding TemMinhasReservas}">
                    <Label Text="Minhas reservas" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MinhasReservas}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReservaEventoLinha">
                                <Border Style="{StaticResource Cartao}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                            <Label Text="{Binding Detalhe}" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Cancelar" IsVisible="{Binding PodeCancelar}" VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventosViewModel}}, Path=CancelarReservaCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Próximos eventos" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" Margin="0,12,0,0" />
                </VerticalStackLayout>

                <Label Text="Nenhum evento no momento." HorizontalOptions="Center" Margin="0,24"
                       IsVisible="{Binding SemEventos}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Itens}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventoLinha">
                            <Border Style="{StaticResource Cartao}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventosViewModel}}, Path=AbrirCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="17" />
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <Label Text="{Binding Quando}" />
                                    <Label Text="{Binding Onde}" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                    <Label Text="{Binding Ocupacao}" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
