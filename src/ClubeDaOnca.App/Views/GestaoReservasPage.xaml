<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ClubeDaOnca.App.ViewModels"
             xmlns:services="clr-namespace:ClubeDaOnca.App.Services"
             x:Class="ClubeDaOnca.App.Views.GestaoReservasPage"
             x:DataType="vm:GestaoReservasViewModel"
             Title="Reservas do clube">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="8" MaximumWidthRequest="900">
        <Picker Grid.Row="0" Title="Mostrar" ItemsSource="{Binding OpcoesFiltro}" SelectedItem="{Binding Filtro}"
                ItemDisplayBinding="{Binding Texto, x:DataType=services:Opcao}" />
        <Label Grid.Row="1" Text="{Binding Resumo}" FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        <Label Grid.Row="2" Text="{Binding Erro}" TextColor="{StaticResource Erro}"
               IsVisible="{Binding Erro, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

        <RefreshView Grid.Row="3" Command="{Binding CarregarCommand}" IsRefreshing="{Binding Carregando}">
            <CollectionView ItemsSource="{Binding Itens}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReservaLinha">
                        <Border Style="{StaticResource Cartao}" Margin="0,4">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Espaco}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Quando}" />
                                <Label Text="{Binding Socio}" />
                                <Label Text="{Binding Detalhe}" FontSize="13" IsVisible="{Binding TemDetalhe}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding StatusTexto}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Gray500}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Confirmada">
                                            <Setter Property="TextColor" Value="#1B873F" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pendente">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0" IsVisible="{Binding PodeCancelar}">
                                    <Button Text="Aprovar" IsVisible="{Binding Pendente}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GestaoReservasViewModel}}, Path=AprovarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Recusar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GestaoReservasViewModel}}, Path=RecusarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Cancelar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GestaoReservasViewModel}}, Path=CancelarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
