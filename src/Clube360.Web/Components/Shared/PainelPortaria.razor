@using System.Globalization
@using Clube360.Contracts
@using Clube360.Web.Services
@inject ApiAutenticada Api

<h2>Portaria</h2>
<p>Registre entradas e saídas de associados, fundadores e dependentes. Horário de Brasília.</p>
@if (_mensagem is not null)
{
    <p class="aviso" role="status">@_mensagem</p>
}
<button type="button" disabled="@_ocupado" @onclick="Atualizar">Atualizar portaria</button>

@if (_dados is not null)
{
    <h3>Registrar entrada</h3>
    <div class="form-grid">
        <label>Buscar por nome ou pelos 4 últimos dígitos do CPF
            <input @bind="_busca" @bind:event="oninput" @bind:after="LimparSelecao" disabled="@_ocupado" />
        </label>
        <label>Associado ou dependente
            <select @bind="_pessoa" @bind:after="NovaTentativa" disabled="@_ocupado">
                <option value="">Selecione</option>
                @foreach (var pessoa in _dados.Elegiveis.Where(Corresponde))
                {
                    <option value="@pessoa.Id">@Identificacao(pessoa.Nome, pessoa.Categoria, pessoa.FinalCpf)</option>
                }
            </select>
        </label>
    </div>
    <button type="button" disabled="@(_ocupado || _pessoa is null)" @onclick="RegistrarEntrada">Registrar entrada</button>

    <h3>Entradas em aberto (@_dados.Presentes.Count)</h3>
    @if (_dados.Presentes.Count == 0)
    {
        <p>Nenhuma entrada em aberto.</p>
    }
    else
    {
        <div class="tabela">
            <table>
                <thead><tr><th>Pessoa</th><th>Entrada</th><th>Ação</th></tr></thead>
                <tbody>
                    @foreach (var visita in _dados.Presentes)
                    {
                        <tr>
                            <td>@Identificacao(visita.Nome, visita.Categoria, visita.FinalCpf)</td>
                            <td>@Hora(visita.EntradaEm)</td>
                            <td>
                                <button type="button" disabled="@_ocupado" @onclick="() => RegistrarSaida(visita.Id)"
                                        aria-label="@($"Registrar saída de {Identificacao(visita.Nome, visita.Categoria, visita.FinalCpf)}")">Registrar saída</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h3>Histórico de entradas e saídas</h3>
    <label>Data da movimentação<input type="date" @bind="_dia" disabled="@_ocupado" /></label>
    <button type="button" disabled="@_ocupado" @onclick="Atualizar">Consultar data</button>
    <p>Movimentações de @_dados.Dia.ToString("dd/MM/yyyy")</p>
    @if (_dados.Historico.Count == 0)
    {
        <p>Nenhuma movimentação nesta data.</p>
    }
    else
    {
        <div class="tabela">
            <table>
                <thead><tr><th>Pessoa</th><th>Entrada</th><th>Registrada por</th><th>Saída</th><th>Registrada por</th></tr></thead>
                <tbody>
                    @foreach (var visita in _dados.Historico)
                    {
                        <tr>
                            <td>@Identificacao(visita.Nome, visita.Categoria, visita.FinalCpf)</td>
                            <td>@Hora(visita.EntradaEm)</td>
                            <td>@visita.EntradaPor</td>
                            <td>@(visita.SaidaEm is { } saida ? Hora(saida) : "Em aberto")</td>
                            <td>@(visita.SaidaPor ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid Clube { get; set; }

    private static readonly TimeZoneInfo Zona = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    private static readonly CompareInfo Comparador = CultureInfo.GetCultureInfo("pt-BR").CompareInfo;
    private PortariaDto? _dados;
    private DateOnly? _dia;
    private Guid? _pessoa;
    private Guid? _tentativa;
    private string _busca = "";
    private bool _ocupado;
    private string? _mensagem;

    private string Rota => $"/api/v1/clubes/{Clube}/portaria";

    protected override Task OnInitializedAsync() => Atualizar();

    private Task Atualizar() => Executar(Carregar);

    private async Task Carregar()
    {
        var consulta = _dia is { } dia ? $"?dia={dia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}" : "";
        _dados = await Api.Get<PortariaDto>(Rota + consulta);
        _dia = _dados.Dia;
        if (_pessoa is { } pessoa && !_dados.Elegiveis.Any(p => p.Id == pessoa))
            LimparSelecao();
    }

    private Task RegistrarEntrada() => Executar(async () =>
    {
        if (_pessoa is not { } pessoa)
            return;

        _tentativa ??= Guid.NewGuid();
        var visita = await Api.Put<VisitaPortariaDto>($"{Rota}/visitas/{_tentativa}", new EntradaPortariaRequest(pessoa));
        LimparSelecao();
        _busca = "";
        _mensagem = $"Entrada de {visita.Nome} registrada.";
        await Carregar();
    });

    private Task RegistrarSaida(Guid id) => Executar(async () =>
    {
        var visita = await Api.Post<VisitaPortariaDto>($"{Rota}/visitas/{id}/saida");
        _mensagem = $"Saída de {visita.Nome} registrada.";
        await Carregar();
    });

    private async Task Executar(Func<Task> acao)
    {
        if (_ocupado)
            return;

        _ocupado = true;
        _mensagem = null;
        try
        {
            await acao();
        }
        catch (Exception erro) when (erro is HttpRequestException or TaskCanceledException)
        {
            _mensagem = _mensagem is null ? erro.Message : _mensagem + " Use Atualizar portaria para recarregar a lista.";
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void LimparSelecao()
    {
        _pessoa = null;
        NovaTentativa();
    }

    private void NovaTentativa() => _tentativa = null;

    private bool Corresponde(PessoaPortariaDto pessoa)
    {
        var busca = _busca.Trim();
        return busca.Length == 0 || Comparador.IndexOf(pessoa.Nome, busca, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0 ||
            pessoa.FinalCpf == busca;
    }

    private static string Identificacao(string nome, string categoria, string finalCpf) =>
        finalCpf.Length == 0 ? $"{nome} · {categoria}" : $"{nome} · {categoria} · CPF final {finalCpf}";

    private static string Hora(DateTimeOffset instante) => TimeZoneInfo.ConvertTime(instante, Zona).ToString("dd/MM/yyyy HH:mm:ss");
}
